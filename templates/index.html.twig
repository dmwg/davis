<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Africa Multiple Calendars</title>
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
        <link rel="manifest" href="/site.webmanifest">
        <link rel="stylesheet" href="/css/bootstrap.min.css" />
        <style>
          html, body {
            height: 100%;
          }

          /* Page is a full-height column: header, calendar */
          .page {
            display: flex;
            flex-direction: column;
            height: 100vh;
            height: 100dvh; /* accounts for mobile browser bars */
            padding: 1rem 1.5rem;
            gap: 1rem;
          }

          /* Header: controls panel left, logo right */
          .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.5rem;
            flex: 0 0 auto;
          }

          /* Fine border around timezone picker + admin links */
          .header-controls {
            display: flex;
            align-items: stretch;
            flex-wrap: wrap;
            border: 1px solid var(--bs-border-color);
            border-radius: 10px;
          }

          .header-controls > * {
            padding: 0.75rem 1.25rem;
          }

          /* Hairline divider between the two groups */
          .header-controls > * + * {
            border-left: 1px solid var(--bs-border-color);
          }

          .timezone-picker,
          .admin-links {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.75rem;
            margin: 0;
          }

          .timezone-picker label,
          .admin-links h2 {
            font-size: 1rem;
            font-weight: 600;
            margin: 0;
          }

          .timezone-picker .form-select {
            width: auto;
            min-width: 14rem;
          }

          .admin-links .btn {
            padding: 0.4rem 1rem;
          }

          .site-logo {
            display: block;
            height: 80px;
            width: auto;
            max-width: 40vw;
            flex-shrink: 0;
          }

          /* Calendar takes all remaining vertical space */
          .calendar-wrapper {
            flex: 1 1 auto;
            min-height: 400px;
            display: flex;
          }

          .calendar-frame {
            flex: 1 1 auto;
            width: 100%;
            height: 100%;
            border: 1px solid var(--bs-border-color);
            border-radius: 10px;
            background: url('https://cal.africamultiple.uni-bayreuth.de/owc/static/img/loaders/circular-loader.gif') center center no-repeat;
          }

          /* Medium screens: stack the two groups inside the bordered panel */
          @media (max-width: 1000px) {
            .header-controls {
              flex-direction: column;
            }

            .header-controls > * + * {
              border-left: 0;
              border-top: 1px solid var(--bs-border-color);
            }
          }

          @media (max-width: 640px) {
            .page {
              padding: 0.75rem;
            }

            .page-header {
              flex-direction: column-reverse;
              align-items: stretch;
            }

            .site-logo {
              height: 56px;
              align-self: flex-end;
            }

            .header-controls > * {
              padding: 0.75rem;
            }

            .timezone-picker .form-select,
            .admin-links .btn {
              flex: 1 1 100%;
              min-width: 0;
            }
          }
        </style>
        <script src="/js/color.mode.toggler.js"></script>
    </head>
    <body>
      <div class="page">

        <header class="page-header">
          <div class="header-controls">
            <div class="timezone-picker">
              <label for="timezoneOption">Select your timezone:</label>
              <select id="timezoneOption" class="form-select">
                <option value="Europe/Berlin">Bayreuth Time</option>
                <option value="Africa/Nairobi">Eldoret Time</option>
                <option value="WAT">Lagos Time</option>
                <option value="SAST">Makhanda Time</option>
                <option value="GMT">Ouagadougou Time</option>
              </select>
            </div>

            <nav class="admin-links" aria-labelledby="adminHeading">
              <h2 id="adminHeading">Administration</h2>
              <a href="https://cal.africamultiple.uni-bayreuth.de/view/" target="_blank" class="btn btn-outline-secondary">Enter Events (registered users only)</a>
            </nav>
          </div>

          <img src="/images/logo_africamultiple_image.svg"
               alt="Africa Multiple Cluster of Excellence"
               class="site-logo">
        </header>

        <main class="calendar-wrapper">
          <iframe id="owcTimezone"
                  class="open-web-calendar calendar-frame"
                  title="Africa Multiple event calendar"
                  src="https://cal.africamultiple.uni-bayreuth.de/owc/calendar.html?specification_url=https://cal.africamultiple.uni-bayreuth.de/specs/specification_all.json&"
                  sandbox="allow-scripts allow-same-origin allow-top-navigation"
                  allowtransparency="true"
                  scrolling="no"></iframe>
        </main>

      </div>

      <script>
        (function () {
          var calendarIFrame = document.getElementById("owcTimezone");
          var timezoneSelect = document.getElementById("timezoneOption");
          var originalUrl = calendarIFrame.src; // the original URL of the iframe

          // Point the calendar at the selected timezone
          function changeTimezone() {
            calendarIFrame.src = originalUrl +
              (timezoneSelect.value ? "timezone=" + encodeURIComponent(timezoneSelect.value) : "");
          }

          timezoneSelect.addEventListener("change", changeTimezone);
          window.addEventListener("load", changeTimezone);
        })();
      </script>
    </body>
</html>
